#!/bin/bash
# Front end on every run (raw echoes, no MP-PCA) and a table of per-echo noise ratios across runs.
# Interactive session:  bash scripts/noise_survey_all.lsf "<mbme_tedana OUT folder>"
# Safe to rerun: finished runs are skipped. Roughly 3-5 minutes per run.
#BSUB -J mejoint_noise
#BSUB -q standard
#BSUB -n 4
#BSUB -R "rusage[mem=4000] span[hosts=1]"
#BSUB -env "all"
#BSUB -o noise_%J.log
set -euo pipefail
PY="$HOME/miniconda3_new/envs/mejoint/bin/python"
PIPELINE_OUT="${1:-}"
REPO=""
for cand in "$(dirname "${BASH_SOURCE[0]:-.}")/.." "$PWD" "${LS_SUBCWD:-}"; do
    if [ -n "$cand" ] && [ -f "$cand/src/mejoint/__init__.py" ]; then REPO="$(cd "$cand" && pwd)"; break; fi
done
[ -n "$REPO" ] || { echo "Cannot find the fMRI-Decomp folder (src/mejoint). Run from inside it." >&2; exit 2; }
cd "$REPO"
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
NT="${LSB_DJOB_NUMPROC:-4}"; export OMP_NUM_THREADS="$NT" MKL_NUM_THREADS="$NT" OPENBLAS_NUM_THREADS="$NT"
[ -n "$PIPELINE_OUT" ] && [ -d "$PIPELINE_OUT" ] || { echo "first argument must be the mbme_tedana OUT folder" >&2; exit 2; }
echo "== mejoint noise survey | $(date) | git $(git rev-parse --short HEAD 2>/dev/null || echo '?')"
status=0
"$PY" -m mejoint.cli frontend-all --pipeline-out "$PIPELINE_OUT" --out outputs/phase2/all --source raw || status=$?
echo "done: $PWD/outputs/phase2/all/noise_survey.md (exit $status)"
exit $status
